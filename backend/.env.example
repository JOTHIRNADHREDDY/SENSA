# SENSA Production Environment Configuration
# Do NOT commit actual secrets to version control.
# Copy this file to .env and fill in the production values.

# ── Database ──
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sensa

# ── Security & Authentication ──
SENSA_SECRET_KEY=
JWT_SECRET=

# ── Billing & Payments ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Communications ──
WHATSAPP_PROVIDER_URL=
WHATSAPP_API_TOKEN=

# ── Storage (Cloud / S3 / R2) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# ── API Environment ──
ENV=production
