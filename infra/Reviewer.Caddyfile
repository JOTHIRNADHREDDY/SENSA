{
	admin off
	auto_https off
}
:8080 {
	bind {$SENSA_REVIEW_BIND:0.0.0.0}
	root * {$SENSA_REVIEW_ROOT:/srv}
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; media-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'"
	}
	@write not method GET HEAD
	respond @write 405
	@root path /
	rewrite @root /demo/index.html
	@approved path /demo/index.html /demo/review.js /demo/review.css /demo/walkthrough.mp4 /demo/evidence/frame-*.png /demo/sources/synthetic-camera-1.mp4 /demo/sources/synthetic-camera-2.mp4 /reports/SENSA_Hackathon_Investigation_Summary_FINAL.pdf /reports/SENSA_Hackathon_Technical_Evidence_Appendix_FINAL.pdf /reports/SENSA_Hackathon_Report_FINAL.json /reports/SHA256SUMS.txt /reports/THIRD_PARTY_NOTICES.txt
	handle @approved {
		file_server
	}
	respond 404
}
