import { motion, AnimatePresence } from 'motion/react';
import React, { useState, useEffect } from 'react';
import { X, CheckCircle2, ArrowRight, Server, Shield, Globe, Cpu, Check, Activity, Database, Lock } from 'lucide-react';
import { PhoneInput, PhoneData } from './PhoneInput';
import { COUNTRIES } from '../data/countries';

interface ContactSalesModalProps {
  isOpen: boolean;
  onClose: () => void;
  onOpenPrivacy: () => void;
  onOpenTerms: () => void;
}

type SiteScale = '1 SITE' | '2–5 SITES' | '6–25 SITES' | '26–100 SITES' | '100+ SITES' | '';
type CameraScale = '1–16' | '17–50' | '51–250' | '251–1,000' | '1,000+' | 'Not sure yet' | '';
type DeploymentModel = 'Local / On-Premise' | 'Hybrid' | 'Cloud' | 'Not Sure' | '';
type Timeline = 'Immediately' | 'Within 30 days' | '1–3 months' | '3–6 months' | '6+ months' | 'Exploring' | '';
type Budget = 'Under $10K / year' | '$10K–$25K' | '$25K–$100K' | '$100K+' | 'Not decided' | '';

export const ContactSalesModal: React.FC<ContactSalesModalProps> = ({ isOpen, onClose, onOpenPrivacy, onOpenTerms }) => {
  const [step, setStep] = useState<1 | 2>(1); // 1: Form, 2: Success
  const [loading, setLoading] = useState(false);
  const [reqId, setReqId] = useState('');

  // Form State
  const [fullName, setFullName] = useState('');
  const [workEmail, setWorkEmail] = useState('');
  const [phoneData, setPhoneData] = useState<PhoneData>({
    country_code: '+1',
    country_iso2: 'US',
    country_name: 'United States',
    phone_number: '',
    phone_e164: '+1',
    is_valid: false
  });
  const [company, setCompany] = useState('');
  const [jobTitle, setJobTitle] = useState('');
  const [countryIso2, setCountryIso2] = useState('US');
  const [industry, setIndustry] = useState('');
  const [siteCount, setSiteCount] = useState<SiteScale>('');
  const [cameraCount, setCameraCount] = useState<CameraScale>('');
  const [deploymentModel, setDeploymentModel] = useState<DeploymentModel>('');
  const [currentInfra, setCurrentInfra] = useState('');
  const [requirements, setRequirements] = useState('');
  const [timeline, setTimeline] = useState<Timeline>('');
  const [budget, setBudget] = useState<Budget>('');
  const [extraInfo, setExtraInfo] = useState('');
  
  const [agreedTerms, setAgreedTerms] = useState(false);
  const [marketingConsent, setMarketingConsent] = useState(false);
  const [errorMsg, setErrorMsg] = useState('');

  // Lock body scroll
  useEffect(() => {
    if (isOpen) {
      document.body.style.overflow = 'hidden';
    } else {
      document.body.style.overflow = 'unset';
    }
    return () => {
      document.body.style.overflow = 'unset';
    };
  }, [isOpen]);

  

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    setErrorMsg('');

    // Basic Validation
    if (!fullName || !workEmail || !company || !jobTitle || !industry) {
      setErrorMsg('Please complete all required contact fields.');
      return;
    }
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(workEmail)) {
      setErrorMsg('Enter a valid work email.');
      return;
    }
    if (!phoneData.is_valid && phoneData.phone_number.length > 0) {
       setErrorMsg('Enter a valid mobile number for the selected country.');
       return;
    }
    if (!siteCount || !cameraCount || !deploymentModel || !timeline) {
      setErrorMsg('Please select your deployment parameters.');
      return;
    }
    if (!agreedTerms) {
      setErrorMsg('Please accept the Terms of Service to continue.');
      return;
    }

    setLoading(true);

    const payload = {
      lead_type: "enterprise",
      full_name: fullName,
      work_email: workEmail,
      phone_e164: phoneData.phone_e164,
      phone_country_iso2: phoneData.country_iso2,
      company: company,
      job_title: jobTitle,
      country_iso2: countryIso2,
      industry: industry,
      site_count: siteCount,
      camera_count: cameraCount,
      deployment_model: deploymentModel,
      current_infrastructure: currentInfra,
      requirements: requirements,
      deployment_timeline: timeline,
      budget_range: budget,
      marketing_consent: marketingConsent,
      terms_version: "1.0",
      privacy_version: "1.0",
      legal_accepted: agreedTerms,
      submitted_at: new Date().toISOString()
    };

    console.log("Submitting Enterprise Request:", payload);

    setTimeout(() => {
      setLoading(false);
      setReqId(`SENSA-ENT-${Math.floor(10000 + Math.random() * 90000)}`);
      setStep(2);
    }, 1500);
  };

  const OptionPill: React.FC<{ selected: boolean, onClick: () => void, children: React.ReactNode }> = ({ selected, onClick, children }) => (
    <button
      type="button"
      onClick={onClick}
      className={`px-4 py-2.5 rounded-lg text-sm font-medium transition-all duration-200 border whitespace-nowrap ${
        selected 
          ? 'bg-sky-500/10 border-sky-500/50 text-sky-400 shadow-[0_0_15px_rgba(14,165,233,0.1)]' 
          : 'bg-slate-900 border-slate-800 text-slate-400 hover:border-slate-700 hover:text-slate-200'
      }`}
    >
      {children}
    </button>
  );

  return (
    <AnimatePresence>
      {isOpen && (
        <div className="fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-slate-950/80 backdrop-blur-md p-4 sm:p-6 lg:p-8">
      <div className="w-full max-w-7xl bg-[#0a0a0b] rounded-2xl border border-slate-800 shadow-2xl overflow-hidden relative min-h-[600px] flex flex-col md:flex-row mt-8 mb-16 animate-in fade-in zoom-in-95 duration-200">
        
        {/* Close Button */}
        <button 
          onClick={onClose}
          className="absolute top-4 right-4 z-20 p-2 text-slate-400 hover:text-white bg-slate-900/50 hover:bg-slate-800 rounded-full transition-colors backdrop-blur-sm"
          aria-label="Close"
        >
          <X className="w-5 h-5" />
        </button>

        {step === 1 ? (
          <>
            {/* Left Column - Information */}
            <div className="w-full md:w-[45%] lg:w-[40%] bg-slate-900/40 p-8 lg:p-12 border-b md:border-b-0 md:border-r border-slate-800 flex flex-col relative overflow-hidden">
              <div className="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-sky-500/5 via-transparent to-purple-500/5" />
              
              <div className="relative z-10 flex-1">
                <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-mono mb-6">
                  <Shield className="w-3.5 h-3.5" />
                  ENTERPRISE DEPLOYMENT
                </div>

                <h1 className="text-3xl lg:text-4xl font-display font-bold text-white mb-4 leading-tight tracking-tight">
                  Let's design your SENSA deployment.
                </h1>
                
                <p className="text-slate-400 text-lg mb-6 leading-relaxed">
                  Tell us about your sites, cameras, infrastructure, and security requirements. Our team will recommend the right deployment architecture for your organization.
                </p>

                <div className="text-[10px] font-mono text-slate-500 mb-10 tracking-widest uppercase">
                  MULTI-SITE • AI VIDEO SECURITY • EDGE DEPLOYMENT
                </div>

                {/* Value Props Card */}
                <div className="bg-slate-900/80 border border-slate-800 rounded-xl p-6 shadow-lg mb-8">
                  <h3 className="text-white font-medium mb-2">Enterprise deployment</h3>
                  <p className="text-sm text-slate-400 mb-6">
                    Built for organizations operating across multiple facilities, cameras, teams, and security environments.
                  </p>

                  <div className="space-y-5">
                    <div className="flex gap-3">
                      <Globe className="w-5 h-5 text-sky-400 shrink-0 mt-0.5" />
                      <div>
                        <div className="text-sm font-medium text-slate-200 mb-0.5">Multi-Site Architecture</div>
                        <div className="text-xs text-slate-500">Manage multiple locations from one SENSA environment.</div>
                      </div>
                    </div>
                    <div className="flex gap-3">
                      <Cpu className="w-5 h-5 text-sky-400 shrink-0 mt-0.5" />
                      <div>
                        <div className="text-sm font-medium text-slate-200 mb-0.5">Edge AI</div>
                        <div className="text-xs text-slate-500">Run AI inference close to the cameras using SENSA Edge infrastructure.</div>
                      </div>
                    </div>
                    <div className="flex gap-3">
                      <Activity className="w-5 h-5 text-sky-400 shrink-0 mt-0.5" />
                      <div>
                        <div className="text-sm font-medium text-slate-200 mb-0.5">Scalable Camera Deployment</div>
                        <div className="text-xs text-slate-500">Support large camera environments with architecture designed around your sites.</div>
                      </div>
                    </div>
                    <div className="flex gap-3">
                      <Database className="w-5 h-5 text-sky-400 shrink-0 mt-0.5" />
                      <div>
                        <div className="text-sm font-medium text-slate-200 mb-0.5">API & Integrations</div>
                        <div className="text-xs text-slate-500">Connect SENSA with existing security, operations, and business systems.</div>
                      </div>
                    </div>
                  </div>
                </div>

                {/* Architecture Visual */}
                <div className="bg-slate-950 rounded-xl border border-slate-800/50 p-6 font-mono text-[10px] text-slate-500 leading-relaxed overflow-hidden">
                  <div className="text-center text-slate-400 mb-2">CAMERAS</div>
                  <div className="flex justify-center text-slate-700 mb-2">│<br/>▼</div>
                  <div className="text-center font-bold text-sky-400 mb-2">SENSA EDGE</div>
                  <div className="pl-4 border-l border-slate-800 ml-12 mb-4 space-y-1">
                    <div className="flex items-center before:content-['├─'] before:mr-2">AI INFERENCE</div>
                    <div className="flex items-center before:content-['├─'] before:mr-2">ALERT ENGINE</div>
                    <div className="flex items-center before:content-['└─'] before:mr-2">LOCAL STORAGE</div>
                  </div>
                  <div className="flex justify-center text-slate-700 mb-2">│<br/>▼</div>
                  <div className="text-center font-bold text-purple-400 mb-2">SENSA PLATFORM</div>
                  <div className="flex justify-center text-slate-700 mb-2">│</div>
                  <div className="flex justify-between max-w-[200px] mx-auto text-center border-t border-slate-800 pt-2 relative">
                    <div className="absolute -top-1 left-0 text-slate-700">▼</div>
                    <div className="absolute -top-1 left-1/2 -translate-x-1/2 text-slate-700">▼</div>
                    <div className="absolute -top-1 right-0 text-slate-700">▼</div>
                    <div className="w-1/3">DASHBOARD</div>
                    <div className="w-1/3">API</div>
                    <div className="w-1/3">REPORTING</div>
                  </div>
                </div>

                {/* Trust Section */}
                <div className="mt-8 pt-8 border-t border-slate-800/50">
                  <div className="text-[10px] font-mono text-slate-600 mb-4 tracking-widest uppercase text-center">
                    DESIGNED FOR SERIOUS DEPLOYMENTS
                  </div>
                  <div className="flex flex-wrap justify-center gap-x-4 gap-y-2 text-xs font-medium text-slate-400">
                    <span>EDGE AI</span>
                    <span className="text-slate-700">•</span>
                    <span>MULTI-SITE</span>
                    <span className="text-slate-700">•</span>
                    <span>ROLE-BASED ACCESS</span>
                    <span className="text-slate-700">•</span>
                    <span>API INTEGRATION</span>
                    <span className="text-slate-700">•</span>
                    <span>DATA RESIDENCY</span>
                    <span className="text-slate-700">•</span>
                    <span>ENTERPRISE SUPPORT</span>
                  </div>
                </div>
              </div>
            </div>

            {/* Right Column - Form */}
            <div className="flex-1 bg-[#0a0a0b] p-8 lg:p-12 h-full overflow-y-auto">
              <div className="max-w-2xl mx-auto">
                <div className="mb-8">
                  <h2 className="text-2xl font-display font-bold text-white mb-2">Talk to SENSA Enterprise</h2>
                  <p className="text-sm text-slate-400">Tell us what you're deploying. We'll help you plan the right architecture.</p>
                </div>

                <form onSubmit={handleSubmit} className="space-y-8">
                  
                  {/* Personal Info */}
                  <div className="space-y-5">
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-5">
                      <div className="space-y-1.5">
                        <label className="text-xs font-mono text-slate-400 ml-1">FULL NAME <span className="text-sky-500">*</span></label>
                        <input
                          type="text"
                          required
                          value={fullName}
                          onChange={(e) => setFullName(e.target.value)}
                          placeholder="Your name"
                          className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-sky-500 transition-colors"
                        />
                      </div>
                      <div className="space-y-1.5">
                        <label className="text-xs font-mono text-slate-400 ml-1">WORK EMAIL <span className="text-sky-500">*</span></label>
                        <input
                          type="email"
                          required
                          value={workEmail}
                          onChange={(e) => setWorkEmail(e.target.value)}
                          placeholder="name@company.com"
                          className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-sky-500 transition-colors"
                        />
                      </div>
                    </div>

                    <div className="grid grid-cols-1 md:grid-cols-2 gap-5">
                      <div className="space-y-1.5">
                        <label className="text-xs font-mono text-slate-400 ml-1">MOBILE NUMBER <span className="text-sky-500">*</span></label>
                        <PhoneInput value={phoneData} onChange={setPhoneData} />
                      </div>
                      <div className="space-y-1.5">
                        <label className="text-xs font-mono text-slate-400 ml-1">COMPANY <span className="text-sky-500">*</span></label>
                        <input
                          type="text"
                          required
                          value={company}
                          onChange={(e) => setCompany(e.target.value)}
                          placeholder="Company name"
                          className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-sky-500 transition-colors"
                        />
                      </div>
                    </div>

                    <div className="grid grid-cols-1 md:grid-cols-2 gap-5">
                      <div className="space-y-1.5">
                        <label className="text-xs font-mono text-slate-400 ml-1">JOB TITLE <span className="text-sky-500">*</span></label>
                        <input
                          type="text"
                          required
                          value={jobTitle}
                          onChange={(e) => setJobTitle(e.target.value)}
                          placeholder="Your role"
                          className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-sky-500 transition-colors"
                        />
                      </div>
                      <div className="space-y-1.5">
                        <label className="text-xs font-mono text-slate-400 ml-1">INDUSTRY <span className="text-sky-500">*</span></label>
                        <select
                          required
                          value={industry}
                          onChange={(e) => setIndustry(e.target.value)}
                          className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-sky-500 transition-colors appearance-none custom-select"
                        >
                          <option value="" disabled className="text-slate-600">Select industry</option>
                          <option value="Manufacturing">Manufacturing</option>
                          <option value="Energy / Solar">Energy / Solar</option>
                          <option value="Logistics">Logistics</option>
                          <option value="Warehouse">Warehouse</option>
                          <option value="Construction">Construction</option>
                          <option value="Retail">Retail</option>
                          <option value="Banking / Financial Services">Banking / Financial Services</option>
                          <option value="Government">Government</option>
                          <option value="Healthcare">Healthcare</option>
                          <option value="Education">Education</option>
                          <option value="Transportation">Transportation</option>
                          <option value="Mining">Mining</option>
                          <option value="Security Services">Security Services</option>
                          <option value="Other">Other</option>
                        </select>
                      </div>
                    </div>
                    <div className="space-y-1.5">
                      <label className="text-xs font-mono text-slate-400 ml-1">COUNTRY / REGION <span className="text-sky-500">*</span></label>
                      <select
                        required
                        value={countryIso2}
                        onChange={(e) => setCountryIso2(e.target.value)}
                        className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-sky-500 transition-colors appearance-none custom-select"
                      >
                        <option value="" disabled className="text-slate-600">Select your country</option>
                        {COUNTRIES.map(c => (
                          <option key={c.iso2} value={c.iso2}>{c.name}</option>
                        ))}
                      </select>
                    </div>
                  </div>

                  <hr className="border-slate-800" />

                  {/* Deployment Scale */}
                  <div className="space-y-4">
                    <label className="text-xs font-mono text-slate-400 ml-1">YOUR DEPLOYMENT <span className="text-sky-500">*</span></label>
                    <div className="flex flex-wrap gap-3">
                      {(['1 SITE', '2–5 SITES', '6–25 SITES', '26–100 SITES', '100+ SITES'] as SiteScale[]).map(scale => (
                        <OptionPill key={scale} selected={siteCount === scale} onClick={() => setSiteCount(scale)}>{scale}</OptionPill>
                      ))}
                    </div>
                  </div>

                  <div className="space-y-4">
                    <label className="text-xs font-mono text-slate-400 ml-1">EXPECTED CAMERA COUNT <span className="text-sky-500">*</span></label>
                    <div className="flex flex-wrap gap-3">
                      {(['1–16', '17–50', '51–250', '251–1,000', '1,000+', 'Not sure yet'] as CameraScale[]).map(scale => (
                        <OptionPill key={scale} selected={cameraCount === scale} onClick={() => setCameraCount(scale)}>{scale}</OptionPill>
                      ))}
                    </div>
                  </div>

                  <div className="space-y-4">
                    <label className="text-xs font-mono text-slate-400 ml-1">DEPLOYMENT PREFERENCE <span className="text-sky-500">*</span></label>
                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                      <button
                        type="button"
                        onClick={() => setDeploymentModel('Local / On-Premise')}
                        className={`p-4 rounded-xl border text-left transition-all ${
                          deploymentModel === 'Local / On-Premise' ? 'bg-sky-500/10 border-sky-500/50' : 'bg-slate-900 border-slate-800 hover:border-slate-700'
                        }`}
                      >
                        <div className={`text-sm font-medium mb-1 ${deploymentModel === 'Local / On-Premise' ? 'text-sky-400' : 'text-slate-200'}`}>Local / On-Premise</div>
                        <div className="text-xs text-slate-500">Keep processing and configured data within your environment.</div>
                      </button>
                      
                      <button
                        type="button"
                        onClick={() => setDeploymentModel('Hybrid')}
                        className={`p-4 rounded-xl border text-left transition-all ${
                          deploymentModel === 'Hybrid' ? 'bg-sky-500/10 border-sky-500/50' : 'bg-slate-900 border-slate-800 hover:border-slate-700'
                        }`}
                      >
                        <div className={`text-sm font-medium mb-1 ${deploymentModel === 'Hybrid' ? 'text-sky-400' : 'text-slate-200'}`}>Hybrid</div>
                        <div className="text-xs text-slate-500">Edge processing with selected cloud services.</div>
                      </button>

                      <button
                        type="button"
                        onClick={() => setDeploymentModel('Cloud')}
                        className={`p-4 rounded-xl border text-left transition-all ${
                          deploymentModel === 'Cloud' ? 'bg-sky-500/10 border-sky-500/50' : 'bg-slate-900 border-slate-800 hover:border-slate-700'
                        }`}
                      >
                        <div className={`text-sm font-medium mb-1 ${deploymentModel === 'Cloud' ? 'text-sky-400' : 'text-slate-200'}`}>Cloud</div>
                        <div className="text-xs text-slate-500">Managed cloud deployment.</div>
                      </button>

                      <button
                        type="button"
                        onClick={() => setDeploymentModel('Not Sure')}
                        className={`p-4 rounded-xl border text-left transition-all flex flex-col justify-center ${
                          deploymentModel === 'Not Sure' ? 'bg-sky-500/10 border-sky-500/50' : 'bg-slate-900 border-slate-800 hover:border-slate-700'
                        }`}
                      >
                        <div className={`text-sm font-medium mb-1 ${deploymentModel === 'Not Sure' ? 'text-sky-400' : 'text-slate-200'}`}>Not Sure</div>
                        <div className="text-xs text-slate-500">Help me choose.</div>
                      </button>
                    </div>
                  </div>

                  <hr className="border-slate-800" />

                  <div className="space-y-4">
                    <label className="text-xs font-mono text-slate-400 ml-1">DEPLOYMENT TIMELINE <span className="text-sky-500">*</span></label>
                    <div className="flex flex-wrap gap-3">
                      {(['Immediately', 'Within 30 days', '1–3 months', '3–6 months', '6+ months', 'Exploring'] as Timeline[]).map(time => (
                        <OptionPill key={time} selected={timeline === time} onClick={() => setTimeline(time)}>{time}</OptionPill>
                      ))}
                    </div>
                  </div>

                  <div className="space-y-4">
                    <label className="text-xs font-mono text-slate-400 ml-1">ESTIMATED SECURITY / AI BUDGET <span className="text-slate-600">(Optional)</span></label>
                    <div className="flex flex-wrap gap-3">
                      {(['Under $10K / year', '$10K–$25K', '$25K–$100K', '$100K+', 'Not decided'] as Budget[]).map(b => (
                        <OptionPill key={b} selected={budget === b} onClick={() => setBudget(b)}>{b}</OptionPill>
                      ))}
                    </div>
                  </div>

                  <hr className="border-slate-800" />

                  {/* Text Areas */}
                  <div className="space-y-5">
                    <div className="space-y-1.5">
                      <label className="text-xs font-mono text-slate-400 ml-1">CURRENT CCTV INFRASTRUCTURE <span className="text-slate-600">(Optional)</span></label>
                      <textarea
                        value={currentInfra}
                        onChange={(e) => setCurrentInfra(e.target.value)}
                        placeholder="Tell us about your existing cameras, NVRs, RTSP/ONVIF infrastructure, or security platform."
                        rows={3}
                        className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-sky-500 transition-colors resize-y min-h-[80px]"
                      />
                    </div>
                    <div className="space-y-1.5">
                      <label className="text-xs font-mono text-slate-400 ml-1">REQUIREMENTS <span className="text-slate-600">(Optional)</span></label>
                      <textarea
                        value={requirements}
                        onChange={(e) => setRequirements(e.target.value)}
                        placeholder="What would you like SENSA to help you achieve? (e.g., intrusion detection, perimeter security, multi-site monitoring, workforce safety...)"
                        rows={3}
                        className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-sky-500 transition-colors resize-y min-h-[80px]"
                      />
                    </div>
                    <div className="space-y-1.5">
                      <label className="text-xs font-mono text-slate-400 ml-1">TELL US ANYTHING ELSE <span className="text-slate-600">(Optional)</span></label>
                      <textarea
                        value={extraInfo}
                        onChange={(e) => setExtraInfo(e.target.value)}
                        placeholder="Deployment requirements, compliance requirements, integrations, locations, timelines, or technical constraints."
                        rows={2}
                        className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-sky-500 transition-colors resize-y min-h-[60px]"
                      />
                    </div>
                  </div>

                  <hr className="border-slate-800" />

                  {/* Consent & Submit */}
                  <div className="space-y-4 pb-4">
                    <label className="flex items-start gap-3 cursor-pointer group">
                      <div className="relative flex items-center justify-center mt-0.5">
                        <input
                          type="checkbox"
                          checked={agreedTerms}
                          onChange={(e) => setAgreedTerms(e.target.checked)}
                          className="peer sr-only"
                        />
                        <div className="w-5 h-5 border-2 border-slate-700 rounded bg-slate-950 peer-checked:bg-sky-500 peer-checked:border-sky-500 transition-colors group-hover:border-slate-500" />
                        <Check className="w-3.5 h-3.5 text-white absolute opacity-0 peer-checked:opacity-100 pointer-events-none" strokeWidth={3} />
                      </div>
                      <span className="text-sm text-slate-400 leading-tight">
                        I agree to the SENSA{' '}
                        <button type="button" onClick={onOpenTerms} className="text-sky-400 hover:text-sky-300 underline underline-offset-2">Terms of Service</button>
                        {' '}and acknowledge the{' '}
                        <button type="button" onClick={onOpenPrivacy} className="text-sky-400 hover:text-sky-300 underline underline-offset-2">Privacy Policy</button>.
                        <span className="text-rose-500 ml-1">*</span>
                      </span>
                    </label>

                    <label className="flex items-start gap-3 cursor-pointer group">
                      <div className="relative flex items-center justify-center mt-0.5">
                        <input
                          type="checkbox"
                          checked={marketingConsent}
                          onChange={(e) => setMarketingConsent(e.target.checked)}
                          className="peer sr-only"
                        />
                        <div className="w-5 h-5 border-2 border-slate-700 rounded bg-slate-950 peer-checked:bg-sky-500 peer-checked:border-sky-500 transition-colors group-hover:border-slate-500" />
                        <Check className="w-3.5 h-3.5 text-white absolute opacity-0 peer-checked:opacity-100 pointer-events-none" strokeWidth={3} />
                      </div>
                      <span className="text-sm text-slate-400 leading-tight">
                        I'd like to receive product updates and occasional marketing communications from SENSA.
                      </span>
                    </label>
                  </div>

                  {errorMsg && (
                    <div className="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm flex items-start gap-3">
                      <div className="mt-0.5 shrink-0">⚠️</div>
                      <div>{errorMsg}</div>
                    </div>
                  )}

                  <button
                    type="submit"
                    disabled={loading}
                    className="w-full py-4 rounded-xl bg-white text-slate-950 font-bold hover:bg-slate-100 transition-all active:scale-[0.98] disabled:opacity-50 disabled:active:scale-100 flex items-center justify-center gap-2 group shadow-[0_0_20px_rgba(255,255,255,0.1)] hover:shadow-[0_0_30px_rgba(255,255,255,0.2)]"
                  >
                    {loading ? (
                      <span className="flex items-center gap-2">
                        <div className="w-4 h-4 border-2 border-slate-950/20 border-t-slate-950 rounded-full animate-spin" />
                        Submitting request...
                      </span>
                    ) : (
                      <>
                        Request Enterprise Consultation
                        <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
                      </>
                    )}
                  </button>

                  <div className="text-[10px] text-slate-600 leading-relaxed text-center mt-6">
                    Your information is used to evaluate your deployment requirements and respond to your enterprise inquiry. See the SENSA{' '}
                    <button type="button" onClick={onOpenPrivacy} className="text-slate-400 hover:text-slate-300 underline">Privacy Policy</button>
                    {' '}for information about personal-data processing.
                  </div>
                </form>
              </div>
            </div>
          </>
        ) : (
          /* Step 2 - Success Screen */
          <div className="flex-1 bg-[#0a0a0b] flex flex-col items-center justify-center p-8 lg:p-16 text-center animate-in fade-in slide-in-from-bottom-4 duration-500 relative overflow-hidden w-full">
            <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-sky-500/10 blur-[100px] pointer-events-none rounded-full" />
            
            <div className="w-20 h-20 rounded-2xl bg-sky-500/10 border border-sky-500/30 flex items-center justify-center mb-8 relative">
              <CheckCircle2 className="w-10 h-10 text-sky-400" />
              <div className="absolute -inset-2 bg-sky-500/20 blur-xl -z-10 rounded-full" />
            </div>
            
            <h2 className="text-4xl font-display font-bold text-white mb-4">Enterprise request received.</h2>
            <p className="text-lg text-slate-400 max-w-lg mb-8 leading-relaxed">
              Thank you. Our team has received your deployment requirements and will review them before contacting you.
            </p>

            <div className="inline-flex flex-col items-center p-4 rounded-xl bg-slate-900 border border-slate-800 mb-12 min-w-[240px]">
              <span className="text-[10px] font-mono text-slate-500 tracking-widest uppercase mb-1">REQUEST ID</span>
              <span className="text-lg font-mono text-sky-400 font-medium">{reqId}</span>
            </div>

            <div className="w-full max-w-2xl text-left">
              <h3 className="text-sm font-mono text-slate-500 tracking-widest uppercase mb-6 text-center">WHAT HAPPENS NEXT</h3>
              
              <div className="space-y-6">
                <div className="flex gap-4">
                  <div className="w-8 h-8 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-xs font-mono text-slate-400 shrink-0 mt-0.5">01</div>
                  <div>
                    <h4 className="text-white font-medium mb-1">Requirements Review</h4>
                    <p className="text-sm text-slate-400 leading-relaxed">Our team reviews your deployment requirements.</p>
                  </div>
                </div>
                <div className="flex gap-4">
                  <div className="w-8 h-8 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-xs font-mono text-slate-400 shrink-0 mt-0.5">02</div>
                  <div>
                    <h4 className="text-white font-medium mb-1">Architecture Discussion</h4>
                    <p className="text-sm text-slate-400 leading-relaxed">We discuss cameras, sites, edge infrastructure, integrations, and compliance requirements.</p>
                  </div>
                </div>
                <div className="flex gap-4">
                  <div className="w-8 h-8 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-xs font-mono text-slate-400 shrink-0 mt-0.5">03</div>
                  <div>
                    <h4 className="text-white font-medium mb-1">Deployment Plan</h4>
                    <p className="text-sm text-slate-400 leading-relaxed">We prepare the recommended SENSA architecture and commercial proposal.</p>
                  </div>
                </div>
              </div>
            </div>

            <button
              onClick={onClose}
              className="mt-12 px-8 py-3 rounded-xl border border-slate-800 text-slate-300 hover:text-white hover:bg-slate-900 transition-colors font-medium"
            >
              Return to Website
            </button>
          </div>
        )}
      </div>
      
      {/* Background styling override for standard select tags */}
      <style>{`
        .custom-select {
          background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%2394a3b8' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
          background-position: right 0.5rem center;
          background-repeat: no-repeat;
          background-size: 1.5em 1.5em;
        }
      `}</style>
            </div>
      )}
    </AnimatePresence>
  );
};
