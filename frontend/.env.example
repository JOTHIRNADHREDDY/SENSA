# VITE_FIREBASE_API_KEY: Required for Firebase Authentication.
VITE_FIREBASE_API_KEY="YOUR_API_KEY"

# VITE_FIREBASE_AUTH_DOMAIN: Firebase auth domain
VITE_FIREBASE_AUTH_DOMAIN="YOUR_AUTH_DOMAIN"

# VITE_FIREBASE_PROJECT_ID: Firebase project id
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"

# VITE_FIREBASE_STORAGE_BUCKET: Firebase storage bucket
VITE_FIREBASE_STORAGE_BUCKET="YOUR_STORAGE_BUCKET"

# VITE_FIREBASE_MESSAGING_SENDER_ID: Firebase messaging sender
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"

# VITE_FIREBASE_APP_ID: Firebase app id
VITE_FIREBASE_APP_ID="YOUR_APP_ID"

# VITE_API_URL: The backend API origin. Defaults to /api via proxy in development.
VITE_API_URL="https://api.sensa.io"
